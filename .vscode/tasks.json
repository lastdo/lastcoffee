{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lastcoffee: free-port-8000",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$conn = Get-NetTCPConnection -LocalPort 8000 -State Listen -ErrorAction SilentlyContinue; if ($conn) { Stop-Process -Id $conn[0].OwningProcess -Force }"
      ],
      "problemMatcher": []
    }
  ]
}
